generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// >>> ORIENTAÇÃO PARA O CODEZ <<<
// Sempre que criar ou alterar tabelas, atualizar os modelos aqui
// (ex.: model User {...}) e incluir uma migration em:
// prisma/migrations/<timestamp>_<nome>/migration.sql
// Não usar "prisma db push" em produção.
